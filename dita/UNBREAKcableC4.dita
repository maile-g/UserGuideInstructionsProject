<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE concept PUBLIC "-//OASIS//DTD DITA Concept//EN" "concept.dtd">
<concept id="UNBREAKcableC4">
    <title>Features of the Multi-Function Button:</title>
    <shortdesc>The Multi-Function Button has several features for music-playing and Bluetooth
        calling that can be used for controlling music playback and managing phone calls,
        navigation, or voice assistant controls on your mobile device easier while
        driving.</shortdesc>
    <conbody>
        <fig id="fig_xq2_3f5_fkc">
            <title>Figure 1: Multi-Function Button controls</title>
            <image href="images/MPButtonEDIT.jpg" placement="break" id="image_plj_syl_jjc"
                width="300" height="300">
                <alt>Image labeling multi-function button on the device.</alt>
            </image>
        </fig>
        <table frame="all" rowsep="1" colsep="1" id="table_gyc_5tt_kjc">
            <title>Key Features of the Multi-Function Button</title>
            <tgroup cols="2">
                <colspec colnum="1" colname="c1" colwidth="1*"/>
                <colspec colnum="2" colname="c2" colwidth="1*"/>
                <thead>
                    <row>
                        <entry><b>Music-Playing Features</b>:</entry>
                        <entry><b>Bluetooth Calling Features:</b></entry>
                    </row>
                </thead>
                <tbody>
                    <row>
                        <entry>
                            <ul>
                                <li>Short Press 1x to play/pause song</li>
                                <li>Slide Left to skip to previous song</li>
                                <li>Slide Right to skip to the next song</li>
                                <li>Slide Up to increase volume</li>
                                <li>Slide Down to lower volume</li>
                            </ul>
                        </entry>
                        <entry>
                            <ul>
                                <li>Short Press 1x to Answer/Hang-up call</li>
                                <li>Long Press 1x to Reject call</li>
                                <li>Short Press 2x to Redial the last call</li>
                                <li>Long press 1x to use Siri/Voice Controls (when not on a call or
                                    while being called)</li>
                            </ul>
                        </entry>
                    </row>
                </tbody>
            </tgroup>
        </table>
        
    </conbody>
</concept>
